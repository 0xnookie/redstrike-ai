# Redstrike container configuration. Copy to docker/.env and fill in.
#   cp docker/.env.example docker/.env
# docker/.env is git-ignored. NEVER commit real tokens or keys.

# ============================================================================
# Claude  — the ONLY live engine today. Provide ONE of A or B (or mount a login).
# ============================================================================
# A) OAuth token (recommended for unattended runs). Create it with:
#      docker compose -f docker/docker-compose.yml run --rm redstrike claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=

# B) API key (alternative to the OAuth token).
ANTHROPIC_API_KEY=

# Pin the model. Opus 5.5:
ANTHROPIC_MODEL=claude-opus-5-5

# (You can also skip A/B and persist an interactive login instead:
#    docker compose -f docker/docker-compose.yml run --rm redstrike claude login
#  it is saved in the `claude-auth` volume and reused on every start.)

# ============================================================================
# Codex  — CLI installed + auth works, but NOT a live engine yet (lab-only until
#          its scope-gate parity is built; see cli/ENGINES.md). Fill if you want
#          its login/key staged now.
# ============================================================================
OPENAI_API_KEY=

# ============================================================================
# Gemini — CLI installed + auth works; no redstrike engine exists yet.
# ============================================================================
GEMINI_API_KEY=

# ============================================================================
# Control plane / engine selection
# ============================================================================
# Leave REDSTRIKE_CONSOLE_TOKEN blank to auto-generate a fresh token each start
# (printed in the logs), or pin one so the console remembers it across restarts.
REDSTRIKE_CONSOLE_TOKEN=

# The live-safe engine. Selecting codex/gemini for a live target is refused
# fail-closed by the launcher until their gating reaches parity.
REDSTRIKE_ENGINE=claude-code
