{
  "version": 1,
  "description": "Deterministic routing map for the Redstrike orchestrator. Each category lists the recon SIGNALS that route it; scripts/coverage.py --plan turns (map + signals + active phases) into a coverage_ledger.json so that EVERY category is recorded as attempted, skipped (with a reason) or n/a (phase not in scope). This replaces model-interpreted routing and wires the formerly un-triggered executors (nosql-injection, ldap-injection, prototype-pollution, race-condition, parameter-pollution, crypto-attacks, tls-attacks, supply-chain) into triggers.",
  "phases": {
    "web": {
      "default": true,
      "desc": "standard black/grey-box web application testing"
    },
    "ai-llm": {
      "default": false,
      "auto_on": "feature:llm-chat|feature:ml-pipeline|feature:agent-tools",
      "desc": "LLM/AI application testing (OWASP LLM Top 10)"
    },
    "web3": {
      "default": false,
      "auto_on": "asset:smart-contract",
      "desc": "smart-contract testing"
    },
    "internal-ad": {
      "default": false,
      "auto_on": "foothold:domain",
      "desc": "internal / assumed-breach / Active Directory"
    },
    "post-exploitation": {
      "default": false,
      "auto_on": "foothold:host",
      "desc": "on a landed host; approval-gated"
    },
    "cloud": {
      "default": false,
      "auto_on": "asset:cloud",
      "desc": "cloud exploitation; approval-gated"
    },
    "mobile": {
      "default": false,
      "auto_on": "asset:mobile-app",
      "desc": "mobile application"
    },
    "iot": {
      "default": false,
      "auto_on": "asset:firmware",
      "desc": "IoT/embedded; approval-gated"
    },
    "wireless": {
      "default": false,
      "auto_on": "asset:wireless",
      "desc": "wireless; approval-gated"
    },
    "social": {
      "default": false,
      "auto_on": "scope:social-authorized",
      "desc": "social engineering; written authorization required"
    },
    "binary": {
      "default": false,
      "auto_on": "asset:binary",
      "desc": "memory-safety fuzzing/exploit-dev"
    },
    "capability": {
      "default": true,
      "desc": "pipeline stages (chaining, exploit generation) over findings"
    }
  },
  "signals": {
    "param:any": "the target exposes request parameters (query/body/path/header)",
    "param:injectable": "a parameter reaches a backend query/interpreter (error/behaviour differential)",
    "param:url-fetching": "a parameter takes a URL/host the server then fetches",
    "param:file-path": "a parameter names a file or path the server reads/includes",
    "param:redirect": "a parameter controls a redirect/forward destination",
    "param:json": "JSON request bodies or structured object parameters are accepted",
    "param:search": "a search/filter/lookup parameter backed by a datastore or directory",
    "sink:template": "user input reaches a server-side template engine",
    "sink:command": "user input can reach an OS command",
    "sink:dom": "a client-side DOM sink consumes URL/input (from js-analysis)",
    "sink:html-reflect": "input is reflected into an HTML response",
    "endpoint:xml": "an endpoint parses XML (SOAP, SAML, upload, API)",
    "endpoint:upload": "a file-upload endpoint exists",
    "endpoint:api": "REST/JSON API endpoints exist",
    "endpoint:graphql": "a GraphQL endpoint exists",
    "endpoint:https": "the target serves TLS/HTTPS",
    "flow:auth": "a login / session / token flow exists",
    "flow:login-form": "a login form is present",
    "flow:password-reset": "a password-reset / forgot-password flow exists",
    "flow:state-change": "cookie-authenticated state-changing actions exist",
    "flow:multi-step": "multi-step workflows / business processes exist",
    "action:limited-state-change": "single-use or quota-limited actions (coupon, purchase, vote, withdraw)",
    "identities:multi": "two or more test identities are available",
    "objref:enumerable": "enumerable object references (sequential/guessable ids)",
    "tech:js-node": "a JavaScript/Node.js stack",
    "tech:nosql": "a NoSQL datastore (MongoDB, CouchDB, ...)",
    "tech:ldap": "an LDAP/directory backend",
    "tech:wordpress": "WordPress fingerprinted",
    "tech:nextjs": "Next.js fingerprinted",
    "token:opaque-nonjwt": "opaque signed/encrypted non-JWT tokens or cookies",
    "infra:cache-cdn": "a cache or CDN sits in front of the app",
    "infra:proxy-chain": "a front-end/back-end proxy chain (smuggling surface)",
    "asset:dangling-dns": "a DNS record points to a claimable/unclaimed resource",
    "artifact:dependency-manifest": "a dependency manifest/lockfile was obtained (incl. recovered backups)",
    "registry:private-scope": "private package scopes / internal registry references",
    "source:available": "application source code is available (white-box)",
    "feature:llm-chat": "an LLM / chatbot / assistant feature is reachable",
    "feature:ml-pipeline": "a training / fine-tune / RAG-ingestion pipeline is reachable",
    "feature:agent-tools": "the LLM can call tools / has agency",
    "asset:smart-contract": "smart contracts are in scope",
    "foothold:domain": "an authenticated Active Directory foothold exists",
    "foothold:host": "a landed host (shell/session) exists",
    "asset:cloud": "cloud credentials or an instance-metadata path are reachable",
    "asset:mobile-app": "a mobile application build is in scope",
    "asset:firmware": "a firmware image / IoT device is in scope",
    "asset:wireless": "a wireless network/device is in scope",
    "asset:binary": "a native binary / network service is in scope for memory-safety testing",
    "scope:social-authorized": "an approved, named social-engineering population is in scope",
    "finding:accepted": "at least one accepted finding exists (pipeline input)"
  },
