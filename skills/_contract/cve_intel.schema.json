{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://redstrike.ai/schemas/cve_intel.schema.json",
  "title": "Redstrike CVE Intel",
  "description": "Emitted by the cve-intelligence capability agent: detected components mapped to applicable CVEs, KEV/EPSS-prioritized (scripts/cve_prioritize.py). Consumed by exploit-generator + bug-bounty + the console /cve-intel page; confirmed-reachable entries also become findings.json. The CVE array is canonically `cves`; `entries` is an accepted alias some runs emit — the console reads either. Each element (either key) is a per-CVE row (see $defs/cve_entry), not a per-component group.",
  "type": "object",
  "required": ["target", "generated_at"],
  "additionalProperties": false,
  "properties": {
    "target": { "type": "string" },
    "generated_at": { "type": "string", "format": "date-time" },
    "scope_ref": { "type": "string" },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "version": { "type": "string" },
          "source": { "type": "string", "description": "libraries.jsonl | site-summary.md | header | banner" }
        }
      }
    },
    "cves": { "type": "array", "items": { "$ref": "#/$defs/cve_entry" }, "description": "Canonical per-CVE array." },
    "entries": { "type": "array", "items": { "$ref": "#/$defs/cve_entry" }, "description": "Accepted alias for `cves` (some runs emit this key; the console reads either). Prefer `cves`." }
  },
  "$defs": {
    "cve_entry": {
      "type": "object",
      "required": ["component", "cve"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^cve-[0-9]{3,}$", "description": "Optional local row id." },
        "component": { "type": "string" },
        "version": { "type": "string" },
        "cve": { "type": "string", "pattern": "^CVE-[0-9]{4}-[0-9]+$" },
        "cvss": { "type": "string" },
        "title": { "type": "string" },
        "exploit_available": { "type": ["boolean", "null"] },
        "exploit_ref": { "type": "string", "description": "exploit-db / metasploit / PoC url" },
        "reachable": { "enum": ["yes", "no", "unknown"] },
        "confidence": { "enum": ["confirmed", "probable", "tentative"] },
        "source": { "type": "array", "items": { "enum": ["osv", "ghsa", "nvd", "retire.js", "grype", "trivy", "osv-scanner", "nuclei"] }, "description": "advisory feed(s) the match came from — prefer >1." },
        "kev": { "type": "boolean", "description": "listed in the CISA Known Exploited Vulnerabilities catalog — test first." },
        "epss": { "type": "number", "minimum": 0, "maximum": 1, "description": "FIRST EPSS 30-day exploitation probability (0..1)." },
        "priority_rank": { "type": "integer", "minimum": 1, "description": "1-based rank from scripts/cve_prioritize.py (KEV > EPSS > reachability > CVSS)." },
        "notes": { "type": "string" }
      }
    }
  }
}
