{
  "target": "juice-shop",
  "name": "OWASP Juice Shop",
  "app_version_tested": "20.3.0",
  "default_base_url": "http://localhost:3000",
  "launch": "docker run --rm -d -p 3000:3000 bkimminich/juice-shop",
  "answer_key": {
    "type": "http-json",
    "endpoint": "/api/Challenges",
    "data_path": "data",
    "id_field": "name",
    "category_field": "category",
    "solved_field": "solved",
    "difficulty_field": "difficulty"
  },
  "category_map": {
    "Injection": ["sqli", "nosql-injection", "injection", "ldap-injection"],
    "Broken Access Control": ["authz", "api"],
    "XSS": ["xss"],
    "Broken Authentication": ["auth"],
    "Sensitive Data Exposure": ["secrets", "exposed-surface"],
    "Cryptographic Issues": ["crypto-attacks", "auth"],
    "Vulnerable Components": ["cve-intelligence", "supply-chain", "framework-nextjs", "framework-wordpress"],
    "Improper Input Validation": ["business-logic", "file"],
    "Security Misconfiguration": ["security-headers", "exposed-surface", "cors"],
    "XXE": ["xxe"],
    "Unvalidated Redirects": ["open-redirect"],
    "Broken Anti Automation": ["business-logic", "race-condition"],
    "Insecure Deserialization": ["injection"],
    "Observability Failures": ["exposed-surface", "secrets"],
    "Security through Obscurity": ["secrets"],
    "Miscellaneous": ["business-logic"]
  },
  "notes": "Answer key is enumerable and machine-checkable via GET /api/Challenges (each challenge has a boolean `solved`). Recall = solved / total, computed overall and per native Juice Shop category. `category_map` ties each Juice Shop category to the Redstrike routing-map categories that should cover it (context, not used for scoring)."
}
